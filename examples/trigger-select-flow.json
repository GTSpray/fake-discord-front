{
  "$schema": "../schema/scenario.schema.json",
  "id": "trigger-select-flow",
  "title": "Menu d'actions (/trigger) — StringSelect éphémère",
  "chrome": {
    "guild": {
      "name": "Serveur de démo"
    },
    "channel": {
      "name": "général",
      "type": "text"
    },
    "membersOnline": 6,
    "viewer": {
      "name": "Modo",
      "status": "Online"
    }
  },
  "actions": [
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "focusInput"
    },
    {
      "type": "wait",
      "ms": 1200
    },
    {
      "type": "type",
      "text": "/trigger",
      "revealSuggestions": {
        "mode": "commandMatch",
        "activeIndex": 0,
        "suggestions": [
          {
            "name": "/trigger",
            "description": "Ouvre le menu d'actions",
            "botName": "Bot"
          }
        ]
      }
    },
    {
      "type": "wait",
      "ms": 900
    },
    {
      "type": "pressEnter"
    },
    {
      "type": "showEphemeral",
      "ephemeral": {
        "author": {
          "name": "Bot",
          "bot": true
        },
        "slashInvocation": {
          "user": {
            "name": "Modo",
            "color": "#5865f2"
          },
          "command": "trigger"
        },
        "type": 4,
        "data": {
          "flags": 64,
          "content": "Que veux-tu faire ?",
          "components": [
            {
              "type": 1,
              "components": [
                {
                  "type": 3,
                  "custom_id": "trigger-action",
                  "placeholder": "Choisis une action...",
                  "options": [
                    { "label": "dit bonjour", "value": "hello" },
                    { "label": "dit au revoir", "value": "bye" }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "wait",
      "ms": 900
    },
    {
      "type": "selectMessageOption",
      "field": "trigger-action",
      "option": "dit bonjour"
    },
    {
      "type": "applyState",
      "holdMs": 2500,
      "layers": {
        "messages": [
          {
            "author": {
              "name": "Bot",
              "bot": true
            },
            "ephemeral": true,
            "slashInvocation": {
              "user": {
                "name": "Modo",
                "color": "#5865f2"
              },
              "command": "trigger"
            },
            "interaction": {
              "type": 4,
              "data": {
                "flags": 64,
                "content": "Que veux-tu faire ?",
                "components": [
                  {
                    "type": 1,
                    "components": [
                      {
                        "type": 3,
                        "custom_id": "trigger-action",
                        "placeholder": "Choisis une action...",
                        "options": [
                          { "label": "dit bonjour", "value": "hello" },
                          { "label": "dit au revoir", "value": "bye" }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ],
        "ephemeral": {
          "author": {
            "name": "Bot",
            "bot": true
          },
          "type": 4,
          "data": {
            "flags": 64,
            "content": "Coucou"
          }
        }
      }
    }
  ],
  "output": {
    "directory": "output",
    "prefix": "trigger-select",
    "video": true
  }
}
